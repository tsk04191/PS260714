# This repository is an allowlist: only code, localization CSV sources, and
# repository documentation are version controlled.
/*
!/.gitignore
!/README.md
!/AGENTS.md
!/GAME_STRUCTURE.md

!/Assets/
/Assets/*

# C# source tree and the Unity metadata required to preserve GUIDs.
!/Assets/10_Scripts.meta
!/Assets/10_Scripts/
/Assets/10_Scripts/**
!/Assets/10_Scripts/**/
!/Assets/10_Scripts/**/*.cs
!/Assets/10_Scripts/**/*.meta

# Localization source data only. Generated C# remains under 10_Scripts.
!/Assets/11_LocalizationSource.meta
!/Assets/11_LocalizationSource/
/Assets/11_LocalizationSource/**
!/Assets/11_LocalizationSource/*.csv
!/Assets/11_LocalizationSource/*.csv.meta
